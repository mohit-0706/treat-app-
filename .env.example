# Copy to .env and fill in.
PORT=3000
DATABASE_URL=postgres://treat:treat@localhost:5432/treat
# DATABASE_SSL=true            # set for most hosted databases (Render, Railway, Neon, Supabase)

# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Links in emails point here (your web app's address)
APP_URL=http://localhost:3000
# Only needed if the web app is hosted on a different address than this server
CORS_ORIGIN=

# Email. Leave SMTP_URL empty in development and emails print in the console.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Treat <no-reply@yourdomain.com>

# REQUIRE_EMAIL_VERIFICATION=false   # true = people must verify before they can sign in
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_ROUNDS=12
# MAX_FAILED_LOGINS=5
# LOCK_MINUTES=15
# RATE_LIMIT_ENABLED=true
# TRUST_PROXY=1                      # set to 1 when behind Render/Railway/nginx so rate limits see real IPs
# AUTO_MIGRATE=true                  # run pending migrations on startup
